# mailbox with gmail.send scope, and store the resulting refresh token securely.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=
QDIP_LEAD_MAILBOX=
