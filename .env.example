# QDIP public origins. Each configured hostname is automatically registered
# as the owner of its surface for host-based routing.
NEXT_PUBLIC_SITE_URL=https://qdip.ai
NEXT_PUBLIC_STUDIO_URL=https://studio.qdip.ai
NEXT_PUBLIC_OBSERVATORY_URL=https://observatory.qdip.ai

# DIP backend
DIP_API_BASE_URL=
DIP_API_KEY=

# QDIP decision inquiry delivery (server-only; never prefix with NEXT_PUBLIC_)
ZOHO_SMTP_USER=hello@qdip.ai
ZOHO_SMTP_PASSWORD=
# Optional overrides. Defaults: smtp.zoho.com and TLS/SSL port 465.
# Use the SMTP hostname assigned to your Zoho data center if it differs.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465

# Zitadel: ONE existing instance, QDIP Web application (Authorization Code + PKCE).
# The registered callback is https://qdip.ai/api/auth/callback/zitadel
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=394566248211424533
# Server-only random secret (at least 32 characters). Generate securely and store in hosting secrets.
QDIP_AUTH_COOKIE_SECRET=
# Comma-separated immutable Zitadel user subject IDs (sub). No public default access.
QDIP_AUTH_ALLOWED_SUBJECTS=
# Subset of allowed subjects authorized to use Kernel-backed RR.
QDIP_AUTH_OPERATOR_SUBJECTS=

# Independent audit attribution assertion secret (>=32 random chars).
# Set the EXACT same secret on qdip-web and qdip-core; never expose publicly.
# RR operator write access fails closed if this is absent.
RR_ACTOR_ASSERTION_SECRET=
